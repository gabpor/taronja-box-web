                <li class="flex items-start gap-2 font-body text-xs text-primary/70 font-bold">
                    <span class="text-accent">✓</span> 12 Sesiones / Mes
                </li>
            </ul>
            <a 
                href="https://taronja.wodbuster.com/user/pagos.aspx" 
                target="_blank" 
                rel="noopener noreferrer"
                class="mt-auto w-full py-3 bg-primary text-white font-body font-bold uppercase text-xs rounded-md hover:bg-accent transition-all text-center"
