                    <span class="font-body font-bold text-sm">/ mes</span>
                </div>
                <div class="mt-4 flex flex-col gap-1 text-[10px] font-body font-bold text-primary/30 uppercase tracking-widest">
                    <span>3 mes: 156,75€</span>
                    <span>1 año: 561,00€</span>
                </div>
            </div>
            <ul class="flex flex-col gap-3 mb-8 w-full text-left">
                <li class="flex items-start gap-2 font-body text-xs text-primary/70">
                    <span class="text-accent">✓</span> Wod, Weightlifting, Open Box
                </li>
                <li class="flex items-start gap-2 font-body text-xs text-primary/70 font-bold">
                    <span class="text-accent">✓</span> 8 Sesiones / Mes
                </li>
            </ul>
            <a 
                href="https://taronja.wodbuster.com/user/pagos.aspx" 
                target="_blank" 
                rel="noopener noreferrer"
                class="mt-auto w-full py-3 bg-primary text-white font-body font-bold uppercase text-xs rounded-md hover:bg-accent transition-all text-center"
            >
                Apúntate
            </a>
        </div>

        <!-- INTERMEDIO 12 SESIONES -->
        <div class="bg-white border border-primary/5 p-8 flex flex-col items-center text-center rounded-md shadow-sm hover:shadow-xl transition-all group">
            <h4 class="font-display font-bold text-3xl uppercase text-primary mb-1 leading-none group-hover:text-accent transition-colors">INTERMEDIO 12 SESIONES</h4>
            <div class="flex flex-col items-center mb-6">
                <div class="flex items-baseline gap-1 text-primary font-display font-bold">
                    <span class="text-6xl text-primary">€ 65</span>
                    <span class="font-body font-bold text-sm">/ mes</span>
                </div>
                <div class="mt-4 flex flex-col gap-1 text-[10px] font-body font-bold text-primary/30 uppercase tracking-widest">
                    <span>3 mes: 185,25€</span>
                    <span>1 año: 663,00€</span>
                </div>
            </div>
            <ul class="flex flex-col gap-3 mb-8 w-full text-left">
