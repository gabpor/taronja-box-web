            <h4 class="font-display font-bold text-3xl uppercase text-primary mb-1 leading-none group-hover:text-accent transition-colors">ELITE ILIMITADA</h4>
            <div class="flex flex-col items-center mb-6">
                <div class="flex items-baseline gap-1 text-primary font-display font-bold">
                    <span class="text-6xl">€ 85</span>
                    <span class="font-body font-bold text-sm">/ mes</span>
