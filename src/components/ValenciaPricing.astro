                Apúntate
            </a>
        </div>

        <!-- RX 16 SESIONES (FEATURED) -->
        <div class="bg-white border-2 border-accent p-8 flex flex-col items-center text-center rounded-md shadow-xl hover:shadow-2xl transition-all group relative py-10">
            <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-primary text-white text-[9px] font-bold px-5 py-1.5 uppercase tracking-widest rounded-full shadow-md whitespace-nowrap border border-white/10">
                El más popular
            </div>
            <h4 class="font-display font-bold text-4xl uppercase text-primary mb-1 leading-none">RX 16 SESIONES</h4>
            <div class="flex flex-col items-center mb-6">
                <div class="flex items-baseline gap-1 text-primary font-display font-bold">
                    <span class="text-6xl text-primary">€ 75</span>
                    <span class="font-body font-bold text-sm">/ mes</span>
                </div>
                <div class="mt-4 flex flex-col gap-1 text-[10px] font-body font-bold text-primary/30 uppercase tracking-widest">
                    <span>3 mes: 213,75€</span>
                    <span>1 año: 765,00€</span>
                </div>
            </div>
            <ul class="flex flex-col gap-3 mb-8 w-full text-left">
                <li class="flex items-start gap-2 font-body text-xs text-primary/70">
                    <span class="text-accent font-bold">✓</span> Wod, Weightlifting, Open Box
                </li>
                <li class="flex items-start gap-2 font-body text-xs text-primary/70 font-bold">
                    <span class="text-accent">✓</span> 16 Sesiones / Mes
                </li>
            </ul>
