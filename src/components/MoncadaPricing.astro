                    </div>
                    <span class="font-display text-3xl text-primary">40€</span>
                </div>

                <!-- Bono 10 -->
                <div class="flex justify-between items-center bg-white p-5 rounded-md border border-primary/5 shadow-sm hover:shadow-md transition-all border-l-4 border-l-primary/20">
                    <div class="flex flex-col">
                        <span class="font-body font-bold text-xs uppercase tracking-wider text-primary/40 leading-none mb-1">Más Popular</span>
                        <span class="font-body font-extrabold text-sm uppercase text-primary">Bono 10</span>
                    </div>
