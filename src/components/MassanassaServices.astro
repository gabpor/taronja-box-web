---
// src/components/MassanassaServices.astro
---
<section id="servicios" class="w-full bg-white text-primary py-16 md:py-24 px-4 md:px-8 lg:px-24 xl:px-32 flex flex-col items-start overflow-hidden">
    
    <!-- Header Area -->
    <div class="w-full flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div class="max-w-2xl">
            <h3 class="font-display font-bold text-5xl md:text-7xl uppercase text-primary mb-6">
                SERVICIOS
            </h3>
            <p class="font-body text-primary/70 text-lg md:text-xl leading-relaxed">
                En Taronja Box Massanassa adaptamos nuestro entrenamiento a tu estilo de vida. Elige el formato que mejor encaje con tus objetivos.
            </p>
        </div>
        
        <!-- Navigation Buttons -->
        <div class="hidden md:flex gap-4 pb-2">
            <button id="services-prev" class="w-14 h-14 rounded-full border border-gray-300 flex items-center justify-center text-gray-400 hover:text-primary hover:border-primary hover:bg-gray-50 transition-colors cursor-pointer" aria-label="Previous slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M5 12L12 19M5 12L12 5" />
                </svg>
            </button>
            <button id="services-next" class="w-14 h-14 rounded-full bg-accent flex items-center justify-center text-white hover:bg-[#c25e36] transition-colors shadow-sm hover:shadow-md cursor-pointer" aria-label="Next slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12H19M19 12L12 5M19 12L12 19" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Slider Area -->
    <div class="w-full relative">
        <div id="services-slider" class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-8 pt-2 scroll-smooth hide-scrollbar">
            
            <!-- Card 1: Clases Dirigidas (WOD) -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/clase-grupal-vista-general-taronja-box.webp" alt="Clase dirigida de entrenamiento funcional con vista general del box en Taronja Box Massanassa" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">La esencia en grupo</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Clases Dirigidas (WOD)</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        Sesiones enfocadas en mejorar tu técnica y potencia dentro de un ambiente inmejorable de comunidad. Entrena siempre bajo supervisión experta con planes que se adaptan a tu nivel, desde 2 días por semana hasta acceso totalmente ilimitado.
                    </p>
                </div>
            </article>

            <!-- Card 2: Open Box Continuo -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/clase-gimnasticos-wall-walk-taronja-box.webp" alt="Alumnos practicando wall walks en open box continuo en Taronja Box Massanassa" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Flexibilidad total</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Open Box Continuo</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        Sabemos que tu agenda puede ser impredecible. Por eso, te ofrecemos entrenamiento libre ininterrumpido durante todo nuestro horario de apertura, de 07:00 a 22:00. Un espacio totalmente equipado a tu disposición para que vengas a entrenar a tu propio ritmo.
                    </p>
                </div>
            </article>

            <!-- Card 3: Sesiones 1x1 o grupos reducidos -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/taronja-box-coach-instruccion-tecnica-atleta-crosstraining-valencia.webp" alt="Coach dando instrucción técnica a atleta en sesión 1x1 en Taronja Box" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Atención personalizada</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Sesiones 1x1 o grupos reducidos</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        Clases de entrenamiento personal adaptadas a tus objetivos. Puedes entrenar de forma individual o en grupos reducidos de hasta 4 personas, con sesiones dinámicas, guiadas y enfocadas en mejorar tu fuerza, resistencia y bienestar.
                    </p>
                </div>
            </article>

            <!-- Card 6: Psicología Deportiva -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/psicologia-deportiva.webp" alt="Sesión de psicología deportiva en Taronja Box Massanassa" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="900" height="1600"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Entrena tu mente</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Psicología Deportiva</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        La mente también se entrena. La psicología deportiva te ayuda a mejorar la concentración, gestionar la presión y fortalecer tu confianza para rendir mejor dentro y fuera del deporte.
                    </p>
                </div>
            </article>

            <!-- Card 7: Osteopatía -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/taronja-box-mujeres-kettlebell-front-rack-clase-wod-valencia.webp" alt="Mujeres con kettlebell en front rack en clase WOD de Taronja Box Massanassa" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Equilibrio y prevención</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Osteopatía</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        La osteopatía ayuda a mejorar el equilibrio del cuerpo, aliviar dolores y prevenir lesiones mediante técnicas manuales que favorecen la movilidad y el bienestar general.
                    </p>
                </div>
            </article>

            <!-- Card 8: Pádel -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/atletas-running-pista-atletismo-taronja-box.webp" alt="Acondicionamiento físico para pádel en Taronja Box Massanassa" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Rendimiento en pista</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Pádel</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        Entrenamiento de acondicionamiento físico pensado para jugadores de pádel. Se trabaja fuerza, velocidad, agilidad y resistencia para mejorar el rendimiento en pista y prevenir lesiones.
                    </p>
                </div>
            </article>

            <!-- Card 10: Fisioterapia -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/taronja-box-valencia-entrenamiento-kettlebell-crosstraining.webp" alt="Entrenamiento con kettlebell en crosstraining en Taronja Box Massanassa" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Recuperación y salud</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Fisioterapia</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        La fisioterapia ayuda a recuperar lesiones, aliviar dolores y mejorar la movilidad mediante tratamientos personalizados que favorecen la salud y el rendimiento físico.
                    </p>
                </div>
            </article>

        </div>
    </div>
</section>

<style>
    .font-display { font-family: 'Bebas Neue', sans-serif; }
    .font-body { font-family: 'Open Sans', sans-serif; }
    
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slider = document.getElementById('services-slider');
        const prevBtn = document.getElementById('services-prev');
        const nextBtn = document.getElementById('services-next');

        if (slider && prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                const card = slider.firstElementChild;
                if (card) {
                    const scrollAmount = card.clientWidth + 24; 
                    slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                }
            });
            
            nextBtn.addEventListener('click', () => {
                const card = slider.firstElementChild;
                if (card) {
                    const scrollAmount = card.clientWidth + 24;
                    slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }
            });
        }
    });
</script>
