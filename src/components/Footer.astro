---
// src/components/Footer.astro
---
<footer class="w-full bg-accent relative overflow-hidden pt-16 pb-10 px-4 md:px-8 lg:px-24 xl:px-32">

    <!-- Background Watermark Logo -->
    <div class="absolute top-1/2 left-0 -translate-x-1/2 -translate-y-1/2 w-[220%] md:w-[180%] lg:w-[140%] h-auto opacity-[0.06] pointer-events-none select-none">
        <img src="/images/logo-footer-watermark.webp" alt="" class="w-full h-auto brightness-0 invert" />
    </div>

    <div class="max-w-[1400px] mx-auto relative z-10">

        <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10 lg:gap-16">

            <!-- Column 1: Logo + Description -->
            <div class="col-span-1 lg:col-span-1 flex flex-col gap-4">
                <a href="/" class="flex items-center gap-3">
                    <img src="/images/logo.webp" alt="Taronja Box" class="h-10 w-auto" />
                    <span class="font-display font-bold text-xl text-white uppercase tracking-wide">Taronja Box</span>
                </a>
                <p class="font-body text-white/50 text-sm leading-relaxed">
                    Entrenamiento funcional de alto rendimiento en comunidad. Cross Training, Open Box y servicios especializados en Valencia.
                </p>
            </div>

            <!-- Column 2: Síguenos -->
            <div class="flex flex-col gap-4 col-span-1 lg:col-span-1">
                <h4 class="font-display font-bold text-lg text-white uppercase tracking-wider">Síguenos</h4>
                <nav class="flex flex-col gap-2.5 font-body text-white/50 text-sm break-all hyphens-auto">
                    <a href="https://www.instagram.com/taronjabox_valencia/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-white transition-colors">
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        <span class="truncate">Taronja Valencia</span>
                    </a>
                    <a href="https://www.instagram.com/taronjabox_massanassa/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-white transition-colors">
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        <span class="truncate">Taronja Massanassa</span>
                    </a>
                    <a href="https://www.instagram.com/taronjabox_moncada/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-white transition-colors">
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        <span class="truncate">Taronja Moncada</span>
                    </a>
                    <a href="https://www.instagram.com/taronjagames/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-white transition-colors">
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                        <span class="truncate">Taronja Games</span>
                    </a>
                </nav>
            </div>

            <!-- Column 3: Navegación -->
            <div class="flex flex-col gap-4 col-span-1 lg:col-span-1">
                <h4 class="font-display font-bold text-lg text-white uppercase tracking-wider">Navegación</h4>
                <nav class="flex flex-col gap-2.5 font-body text-white/50 text-sm">
                    <a href="/" class="hover:text-white transition-colors">Inicio</a>
                    <a href="/valencia/" class="hover:text-white transition-colors">Sede Valencia</a>
                    <a href="/massanassa/" class="hover:text-white transition-colors">Sede Massanassa</a>
                    <a href="/moncada/" class="hover:text-white transition-colors">Sede Moncada</a>
                    <a href="/#servicios" class="hover:text-white transition-colors">Servicios</a>
                    <a href="/#equipo" class="hover:text-white transition-colors">Equipo</a>
                    <a href="/#eventos" class="hover:text-white transition-colors">Eventos</a>
                    <a href="/#faq" class="hover:text-white transition-colors">FAQ</a>
                </nav>
            </div>

            <!-- Column 4: Legal -->
            <div class="flex flex-col gap-4 col-span-1 lg:col-span-1">
                <h4 class="font-display font-bold text-lg text-white uppercase tracking-wider">Legal</h4>
                <nav class="flex flex-col gap-2.5 font-body text-white/50 text-sm">
                    <a href="/privacidad/" class="hover:text-white transition-colors">Privacidad</a>
                    <a href="/cookies/" class="hover:text-white transition-colors">Cookies</a>
                    <a href="/aviso-legal/" class="hover:text-white transition-colors">Aviso Legal</a>
                </nav>
            </div>

        </div>

        <!-- Bottom Copyright -->
        <div class="mt-12 pt-6 border-t border-white/10 text-white/30 font-body text-xs tracking-wider">
            <span>&copy; 2026 Taronja Box</span>
        </div>

    </div>
