---
// src/components/MassanassaCtaServicios.astro
---
<section class="w-full bg-white py-20 px-4 md:px-8 lg:px-24 xl:px-32 flex justify-center">
    <div class="w-full max-w-[1400px]">

        <article class="relative w-full bg-[#131D2D] overflow-hidden rounded py-10 px-8 lg:px-20 min-h-[300px] md:min-h-[350px] flex items-center shadow-2xl">

            <!-- Left Content -->
            <div class="relative z-10 w-full md:w-[70%] flex flex-col items-start gap-10">
                <div class="flex flex-col items-start space-y-4">
                    <h3 class="font-display font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-7xl text-white uppercase leading-none">
                        SERVICIOS <br class="hidden md:block"/> PERSONALIZADOS
                    </h3>
                    <p class="font-body text-white/70 text-sm md:text-base max-w-xl leading-relaxed">
                        Sesiones 1x1, psicología deportiva, osteopatía, preparación para pádel y fisioterapia. Escríbenos y te informamos.
                    </p>
                </div>

                <a href="https://wa.me/34625480633?text=%C2%A1Hola!%20Me%20interesa%20informaci%C3%B3n%20sobre%20los%20servicios%20personalizados%20de%20Taronja%20Box%20Massanassa%20(sesiones%201x1%2C%20psicolog%C3%ADa%20deportiva%2C%20osteopat%C3%ADa%2C%20p%C3%A1del%2C%20fisioterapia)." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-white text-[#FF8E5E] font-body font-bold text-xs md:text-sm tracking-widest uppercase px-8 py-3.5 rounded-md hover:bg-gray-50 transition-all shadow-lg active:scale-95 group">
                    CONTACTAR POR WHATSAPP
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>

            <!-- Right Background Graphic (Logo Watermark) -->
            <div class="absolute right-[-15%] md:right-[-10%] top-[60%] md:top-[60%] -translate-y-1/4 h-[195%] md:h-[200%] w-auto opacity-100 pointer-events-none">
                <img
                    src="/images/logo-taronja-naranja.webp"
                    alt="Taronja Box Logo Design"
                    class="h-full w-auto object-contain"
                />
            </div>

        </article>

    </div>
</section>
