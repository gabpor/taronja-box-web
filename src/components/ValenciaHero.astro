---
// src/components/ValenciaHero.astro
---
<section class="w-full bg-[#FFF7F2] overflow-hidden flex flex-col md:flex-row md:h-[70vh] md:min-h-[500px] pt-16 md:pt-20">
    <!-- Left Side: Typography -->
    <div class="w-full md:w-1/2 flex flex-col justify-center px-6 md:px-8 lg:px-24 xl:px-32 py-10 md:py-0 text-left">
        <h1 class="font-display font-bold uppercase text-primary leading-[0.8] md:leading-tight flex flex-col">
            <span class="text-5xl md:text-5xl lg:text-6xl">Taronja Box</span>
            <span class="text-8xl md:text-8xl lg:text-9xl xl:text-[10rem] text-accent mt-[-0.05em]">VALENCIA</span>
        </h1>
        <p class="font-body text-primary/60 mt-4 md:mt-6 max-w-md text-sm md:text-base font-medium leading-relaxed">
            Box de cross training y entrenamiento funcional en Benicalap, Valencia. Clases WOD diarias, open box y comunidad real. El gimnasio funcional de referencia en Valencia.
        </p>

        <!-- Subtle Instagram Link -->
        <a href="https://www.instagram.com/taronjabox_valencia/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-2 mt-6 md:mt-8 text-primary/40 hover:text-accent transition-colors w-fit">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span class="font-body text-[10px] md:text-xs font-bold uppercase tracking-[0.2em]">@taronjabox_valencia</span>
        </a>
    </div>

    <!-- Right Side: Image -->
    <div class="w-full md:w-1/2 aspect-square md:aspect-auto md:h-full relative overflow-hidden">
        <img 
            src="/images/box-valencia.webp" 
            alt="Atmosfera Taronja Box Valencia" 
            class="absolute inset-0 w-full h-full object-cover"
            fetchpriority="high"
        />
        <!-- Subtle overlay to blend with the left side -->
        <div class="absolute inset-0 bg-primary/5"></div>
    </div>
</section>
