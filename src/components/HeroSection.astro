---
// src/components/HeroSection.astro
// Hero oscuro con H1 de comunidad y botones duales
// ÚNICO H1 de toda la página index.astro
---

<section
  id="hero"
  class="relative min-h-screen bg-primary flex flex-col justify-center overflow-hidden"
  aria-labelledby="hero-heading"
>
  <!-- ── Decoración de fondo ── -->
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- ── Contenido principal ── -->
  <div class="relative z-10 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-20 md:py-28 flex flex-col items-center text-center">

    <!-- Eyebrow badge -->
    <div class="inline-flex items-center gap-2 border border-accent/30 bg-accent/10 text-accent text-xs sm:text-sm font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-8 md:mb-10">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-11.25a.75.75 0 00-1.5 0v2.5h-2.5a.75.75 0 000 1.5h2.5v2.5a.75.75 0 001.5 0v-2.5h2.5a.75.75 0 000-1.5h-2.5v-2.5z" clip-rule="evenodd" />
      </svg>
      Comunidad de Alto Rendimiento
    </div>

    <!-- ── H1 — ÚNICO en toda la página ── -->
    <h1
      id="hero-heading"
      class="font-display font-black uppercase leading-none tracking-tight text-white text-5xl sm:text-6xl md:text-7xl lg:text-8xl max-w-5xl mb-6 md:mb-8"
    >
      Donde se forjan<br />
      <span class="hero-accent">los atletas</span>
    </h1>

    <!-- Subtítulo -->
    <p class="text-white/55 text-base sm:text-lg md:text-xl max-w-2xl mb-12 md:mb-16 leading-relaxed">
      Cross training y entrenamiento funcional de élite en Valencia, Moncada y Massanasa.
      Entrena con nosotros y transforma tu cuerpo y tu mente.
    </p>

    <!-- ── Botones duales ── -->
    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a
        href="#sedes"
        class="inline-flex items-center gap-2.5 bg-accent hover:bg-accent-500 text-white font-bold text-base px-8 py-4 rounded-full transition-colors duration-200 shadow-lg shadow-accent/20 hover:shadow-accent/30"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5" aria-hidden="true">
          <path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 14.988 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 5.988 3.355 7.584a13.731 13.731 0 002.007 1.598 11.651 11.651 0 00.589.35l.012.006zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd" />
        </svg>
        Elige tu sede
      </a>
      <a
        href="#manifiesto"
        class="inline-flex items-center gap-2 text-white/70 hover:text-white font-semibold text-base px-6 py-4 rounded-full border border-white/15 hover:border-white/30 transition-all duration-200"
      >
        Nuestra Filosofía
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4" aria-hidden="true">
          <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z" clip-rule="evenodd" />
        </svg>
      </a>
    </div>
  </div>

  <!-- ── Scroll indicator ── -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-1.5" aria-hidden="true">
    <span class="text-white/25 text-xs font-medium uppercase tracking-widest">Scroll</span>
    <div class="scroll-chevron">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-white/25">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 75% 15%, hsl(17 66% 55% / 0.13) 0%, transparent 55%),
      radial-gradient(ellipse at 25% 85%, hsl(17 66% 55% / 0.06) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 56px 56px;
    pointer-events: none;
  }

  .hero-accent {
    background: linear-gradient(90deg, hsl(17 66% 55%) 0%, hsl(17 66% 65%) 50%, hsl(17 66% 55%) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @keyframes bounce-soft {
    0%, 100% { transform: translateY(0); opacity: 0.3; }
    50%       { transform: translateY(5px); opacity: 0.6; }
  }

  .scroll-chevron {
    animation: bounce-soft 2s ease-in-out infinite;
  }
</style>
