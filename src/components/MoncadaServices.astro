---
// src/components/MoncadaServices.astro
---
<section id="servicios" class="w-full bg-white text-primary py-16 md:py-24 px-4 md:px-8 lg:px-24 xl:px-32 flex flex-col items-start overflow-hidden">
    
    <!-- Header Area -->
    <div class="w-full flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
        <div class="max-w-2xl">
            <h3 class="font-display font-bold text-5xl md:text-7xl uppercase text-primary mb-6">
                SERVICIOS
            </h3>
            <p class="font-body text-primary/70 text-lg md:text-xl leading-relaxed">
                Descubre todo lo que ofrecemos en Moncada para llevar tu entrenamiento al siguiente nivel. Variedad, comunidad y resultados.
            </p>
        </div>
        
        <!-- Navigation Buttons -->
        <div class="hidden md:flex gap-4 pb-2">
            <button id="services-prev" class="w-14 h-14 rounded-full border border-gray-300 flex items-center justify-center text-gray-400 hover:text-primary hover:border-primary hover:bg-gray-50 transition-colors cursor-pointer" aria-label="Previous slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M5 12L12 19M5 12L12 5" />
                </svg>
            </button>
            <button id="services-next" class="w-14 h-14 rounded-full bg-accent flex items-center justify-center text-white hover:bg-[#c25e36] transition-colors shadow-sm hover:shadow-md cursor-pointer" aria-label="Next slide">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12H19M19 12L12 5M19 12L12 19" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Slider Area -->
    <div class="w-full relative">
        <div id="services-slider" class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-8 pt-2 scroll-smooth hide-scrollbar">
            
            <!-- Card 1: Clases Dirigidas (WOD) -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/panoramica-interior-clase-grupal-taronja-box.webp" alt="Clase dirigida de entrenamiento funcional en Taronja Box Moncada con alumnos entrenando" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">El entrenamiento principal</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Clases Dirigidas (WOD)</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        La base de nuestro método. Sesiones de entrenamiento de alta intensidad con programación variada, pensadas para todos los niveles. Supera tus propios límites día a día en un entorno inmejorable y con el apoyo constante de nuestra comunidad.
                    </p>
                </div>
            </article>

            <!-- Card 2: Especialidades -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/taronja-box-coach-demostracion-pull-up-barra-clase-crosstraining-valencia.webp" alt="Coach demostrando pull-up en barra durante clase de especialidades en Taronja Box Moncada" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Pulir detalles</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Especialidades</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        Domina cada aspecto del fitness con nuestras clases específicas. Desde Weightlifting para ganar fuerza y potencia, hasta Gymnastics para mejorar tu control corporal. La opción perfecta para enfocarte en tus puntos débiles y convertirlos en fortalezas.
                    </p>
                </div>
            </article>

            <!-- Card 3: Open Box -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/taronja-box-coach-atleta-pull-up-dominadas-barra-crosstraining.webp" alt="Coach con atleta en pull-up y dominadas en barra en Taronja Box Moncada" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Entrena a tu manera</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">Open Box</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        Disfruta de nuestras instalaciones con total libertad y a tu propio ritmo. Muchos de nuestros planes combinan WODs con sesiones de Open Box para que puedas dedicar tiempo extra a la técnica, la movilidad o a tu propia programación.
                    </p>
                </div>
            </article>
            
            <!-- Card 4: CrossKids y Adolescentes -->
            <article class="flex-shrink-0 w-[60vw] md:w-[400px] lg:w-[450px] bg-white border border-accent/20 flex flex-col snap-center group cursor-pointer transition-shadow hover:shadow-md overflow-hidden">
                <div class="w-full aspect-[4/3] overflow-hidden bg-primary-dark">
                    <img src="/images/taronja-box-coach-atleta-comunidad-clase-box-jump-crosstraining-valencia.webp" alt="Coaches y atletas en clase de box jump comunitaria en Taronja Box Moncada" class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" loading="lazy" decoding="async" width="1600" height="1200"/>
                </div>
                <div class="p-6 md:p-8 flex flex-col flex-grow">
                    <span class="text-[10px] uppercase font-body tracking-widest text-primary/40 mb-3 font-bold">Fitness desde pequeños</span>
                    <h4 class="text-3xl md:text-4xl font-display font-bold text-primary mb-4 transition-colors duration-300 group-hover:text-accent uppercase">CrossKids y Adolescentes</h4>
                    <p class="hidden md:block font-body text-primary/60 text-sm leading-relaxed mb-8 flex-grow">
                        En Taronja Box apostamos por el movimiento a todas las edades. Contamos con clases de CrossKids y planes específicos para Teens, enfocados en enseñarles buenos hábitos, técnica y trabajo en equipo desde una edad temprana.
                    </p>
                </div>
            </article>

        </div>
    </div>
</section>

<style>
    .font-display { font-family: 'Bebas Neue', sans-serif; }
    .font-body { font-family: 'Open Sans', sans-serif; }
    
    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slider = document.getElementById('services-slider');
        const prevBtn = document.getElementById('services-prev');
        const nextBtn = document.getElementById('services-next');

        if (slider && prevBtn && nextBtn) {
            prevBtn.addEventListener('click', () => {
                const card = slider.firstElementChild;
                if (card) {
                    const scrollAmount = card.clientWidth + 24; 
                    slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                }
            });
            
            nextBtn.addEventListener('click', () => {
                const card = slider.firstElementChild;
                if (card) {
                    const scrollAmount = card.clientWidth + 24;
                    slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }
            });
        }
    });
</script>
