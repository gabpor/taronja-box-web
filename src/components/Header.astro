---
// src/components/Header.astro
const pathname = Astro.url.pathname;
// Normalizamos el pathname quitando barras finales si existen
const cleanPath = pathname.endsWith('/') && pathname.length > 1 ? pathname.slice(0, -1) : pathname;

const isHome = cleanPath === '/' || cleanPath === '';
const isAbout = cleanPath === '/about';
const origin = Astro.url.searchParams.get('origin');

const sedesSublinks = [
    { name: 'Valencia', href: '/valencia/' },
    { name: 'Massanassa', href: '/massanassa/' },
    { name: 'Moncada', href: '/moncada/' }
];

const homeLinks = [
    { name: 'Filosofía', href: '/about/' },
    { name: 'Sedes', sublinks: sedesSublinks },
    { name: 'Servicios', href: '/#servicios' },
    { name: 'Equipo', href: '/#equipo' },
    { name: 'Eventos', href: '/#eventos' },
    { name: 'FAQ', href: '/#faq' }
];

// Identificamos en qué sede estamos o de cuál venimos
const isSedePage = !isHome && !isAbout;
const validSedes = ['valencia', 'massanassa', 'moncada'];
const currentSede = isSedePage ? cleanPath.replace('/', '') : origin;
const isSedeMode = isSedePage || (isAbout && origin && validSedes.includes(origin));

// Si estamos en la página "about", necesitamos que los links de la sede sean rutas absolutas
const baseSedePath = (isAbout && isSedeMode) ? `/${origin}` : '';

const sedeLinks = [
    { name: 'Nosotros', href: '/' },
    { name: 'Sedes', sublinks: sedesSublinks },
    { name: 'Servicios', href: '/#servicios' },
    { name: 'Horarios', href: `${baseSedePath}#horarios` },
    { name: 'Tarifas', href: `${baseSedePath}#precios` },
    { name: 'Filosofía', href: `/about/?origin=${isSedePage ? currentSede : (origin || 'sede')}` }
];

const links = isSedeMode ? sedeLinks : homeLinks;

// El header solo es transparente en el Hero de la Home real
const isTransparentHeader = isHome;
---

<header 
    id="main-header" 
    class:list={[
        "fixed w-full top-0 left-0 z-[60] transition-all duration-300 border-b",
        isTransparentHeader 
            ? "bg-transparent text-white border-white/5" 
            : "bg-primary/95 backdrop-blur-md border-white/10 shadow-xl text-white"
    ]}
>
    <div class="w-full max-w-[1400px] mx-auto flex items-center justify-between px-4 py-3 md:px-8 lg:px-24 xl:px-32">
        <div class="flex-shrink-0">
            <a href="/" class="block w-14 h-14 flex items-center justify-center">
                <img src="/images/logo.webp" alt="Taronja Box" class="w-full h-full object-contain" />
            </a>
        </div>
        
        <nav class="hidden lg:flex gap-8 items-center">
            {links.map(link => (
                link.sublinks ? (
                    <div class="relative group/dropdown py-4">
                        <button class="flex items-center gap-1.5 font-body text-sm font-semibold uppercase tracking-[0.1em] text-white/80 group-hover/dropdown:text-accent transition-colors">
                            {link.name}
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 group-hover/dropdown:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <div class="absolute left-1/2 -translate-x-1/2 top-full hidden group-hover/dropdown:block pt-2 w-48 animate-in fade-in slide-in-from-top-2 duration-200">
                            <div class="bg-primary/95 backdrop-blur-md border border-white/10 rounded-xl overflow-hidden shadow-2xl p-1">
                                {link.sublinks.map(sublink => (
                                    <a 
                                        href={sublink.href} 
                                        class="block px-4 py-2.5 rounded-lg font-body text-xs font-bold uppercase tracking-widest text-white/70 hover:bg-white/10 hover:text-white transition-all"
                                    >
                                        {sublink.name}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                ) : (
                    <a href={link.href} class="font-body text-sm font-semibold uppercase tracking-[0.1em] text-white/80 hover:text-accent transition-colors py-4">
                        {link.name}
                    </a>
                )
            ))}
        </nav>
        
        <div class="flex items-center gap-4 lg:gap-0">
            <div class="flex-shrink-0">
                <a id="header-cta-btn" href="https://docs.google.com/forms/d/e/1FAIpQLSeca-KSyalf-i9ft_x-yq8wbunnGlH3Ib4TxC83ZpTSr4GU4g/viewform" class="bg-accent hover:bg-accent-hover text-white font-body font-bold text-[10px] md:text-xs uppercase px-4 md:px-6 py-2.5 md:py-3 tracking-[0.15em] rounded-md transition-colors whitespace-nowrap">
                    Prueba una clase
                </a>
            </div>

            <button 
                id="menu-toggle" 
                class="lg:hidden flex flex-col justify-center items-center w-10 h-10 gap-1.5 focus:outline-none group z-[70]"
                aria-label="Toggle Menu"
            >
                <span class="w-6 h-0.5 bg-white transition-all duration-300 group-[.active]:rotate-45 group-[.active]:translate-y-2"></span>
                <span class="w-6 h-0.5 bg-white transition-all duration-300 group-[.active]:opacity-0"></span>
                <span class="w-6 h-0.5 bg-white transition-all duration-300 group-[.active]:-rotate-45 group-[.active]:-translate-y-2"></span>
            </button>
        </div>
    </div>
</header>
<div 
    id="mobile-menu" 
    class="fixed inset-0 z-50 pointer-events-none overflow-hidden"
>
    <div id="menu-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>
    
    <nav class="absolute top-0 right-0 w-[80%] max-w-sm h-full bg-primary-dark shadow-2xl translate-x-full transition-transform duration-300 ease-in-out p-12 flex flex-col gap-8 pointer-events-auto border-l border-white/10 pt-24">
        <div class="flex flex-col gap-6 mt-4">
            {links.map(link => (
                link.sublinks ? (
                    <div class="flex flex-col gap-4">
                        <span class="font-display text-4xl font-bold uppercase tracking-wider text-accent">{link.name}</span>
                        <div class="flex flex-col gap-3 pl-4">
                            {link.sublinks.map(sublink => (
                                <a href={sublink.href} class="mobile-link font-display text-3xl font-bold uppercase tracking-wider text-white/60 hover:text-white transition-colors">
                                    {sublink.name}
                                </a>
                            ))}
                        </div>
                    </div>
                ) : (
                    <a href={link.href} class="mobile-link font-display text-4xl font-bold uppercase tracking-wider text-white hover:text-accent transition-colors">
                        {link.name}
                    </a>
                )
            ))}
        </div>


    </nav>
</div>

<script define:vars={{ isTransparentHeader }}>
    const header = document.getElementById('main-header');
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuContent = mobileMenu?.querySelector('nav');
    const menuBackdrop = document.getElementById('menu-backdrop');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    
    // Header background on scroll
    if (header && isTransparentHeader) {
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                header.classList.remove('bg-transparent', 'border-white/5');
                header.classList.add('bg-primary/95', 'backdrop-blur-md', 'border-white/10', 'shadow-xl');
            } else {
                header.classList.add('bg-transparent', 'border-white/5');
                header.classList.remove('bg-primary/95', 'backdrop-blur-md', 'border-white/10', 'shadow-xl');
            }
        });
    }

    // Toggle Mobile Menu
    const toggleMenu = (show) => {
        if (!mobileMenu || !menuContent || !menuBackdrop || !menuToggle) return;
        
        if (show) {
            mobileMenu.classList.remove('pointer-events-none');
            menuToggle.classList.add('active');
            menuContent.classList.remove('translate-x-full');
            menuBackdrop.classList.remove('opacity-0');
            menuBackdrop.classList.add('opacity-100');
            document.body.style.overflow = 'hidden';
        } else {
            mobileMenu.classList.add('pointer-events-none');
            menuToggle.classList.remove('active');
            menuContent.classList.add('translate-x-full');
            menuBackdrop.classList.add('opacity-0');
            menuBackdrop.classList.remove('opacity-100');
            document.body.style.overflow = 'auto';
        }
    };

    menuToggle?.addEventListener('click', () => {
        const isActive = menuToggle.classList.contains('active');
        toggleMenu(!isActive);
    });

    menuBackdrop?.addEventListener('click', () => toggleMenu(false));
    
    mobileLinks.forEach(link => {
        link.addEventListener('click', () => toggleMenu(false));
    });
</script>
