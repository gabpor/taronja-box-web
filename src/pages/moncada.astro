---
// src/pages/moncada.astro
import Layout from '../layouts/Layout.astro';
import MoncadaHero from '../components/MoncadaHero.astro';

import MoncadaPricing from '../components/MoncadaPricing.astro';
import MoncadaSchedule from '../components/MoncadaSchedule.astro';
import FaqSection from '../components/FaqSection.astro';
import CtaServicios from '../components/CtaServicios.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { buildLocationSchema } from '../lib/schema';

const schema = buildLocationSchema({
    path: '/moncada/',
    name: 'Taronja Box Moncada',
    description: 'Cross training y entrenamiento funcional en Moncada, norte de Valencia. WOD diario, CrossKids, especialidades y open box para toda la familia.',
    telephone: '+34626734479',
    address: {
        streetAddress: 'C. 220, 2',
        addressLocality: 'Moncada',
        postalCode: '46116',
        addressCountry: 'ES',
    },
    geo: { latitude: 39.5784, longitude: -0.3960 },
    sameAs: ['https://www.instagram.com/taronjabox_moncada/'],
});
---

<Layout
    title="Cross Training y Entrenamiento en Moncada | Taronja Box Moncada"
    description="Taronja Box Moncada — cross training y entrenamiento funcional en Moncada, Camp de Túria. WOD diario, CrossKids, especialidades y open box. La referencia deportiva del norte de Valencia."
>
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
    <MoncadaHero />
    <div class="bg-white">
        <MoncadaSchedule />

        <MoncadaPricing />
        
        <!-- Dónde Estamos -->
        <section class="w-full bg-white text-primary pb-8 md:pb-16 px-4 md:px-8 lg:px-24 xl:px-32 flex flex-col items-start overflow-hidden">
            <div class="max-w-2xl mb-8 md:mb-12">
                <h3 class="font-display font-bold text-5xl md:text-7xl uppercase text-primary mb-6 text-left">
                    DÓNDE ESTAMOS
                </h3>
                <p class="font-body text-base md:text-lg text-primary/70 text-left leading-relaxed">
                    Taronja Box Moncada <br class="hidden sm:block"/>
                    C. 220, 2, 46116 Moncada, Valencia
                </p>
            </div>
            
            <div class="w-full relative group rounded-xl overflow-hidden shadow-lg border border-primary/5">
                <!-- Google Maps iframe -->
                <iframe 
                    src="https://maps.google.com/maps?q=Taronja+Box+Moncada,+C.+220,+2,+46116+Moncada,+Valencia&t=&z=15&ie=UTF8&iwloc=&output=embed"
                    width="100%"
                    height="450"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title="Mapa de Taronja Box Moncada"
                    class="w-full grayscale opacity-90 transition-all duration-500 group-hover:grayscale-0 group-hover:opacity-100"
                ></iframe>
                
                <!-- Overlay Button -->
                <a 
                    href="https://www.google.com/maps/dir/?api=1&destination=Taronja+Box+Moncada,+C.+220,+2,+46116+Moncada,+Valencia"
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="absolute bottom-6 left-1/2 -translate-x-1/2 md:left-auto md:right-8 md:translate-x-0 md:bottom-8 bg-accent hover:bg-[#c25e36] text-white font-body font-bold text-sm md:text-base uppercase px-8 py-4 rounded-md tracking-widest shadow-2xl transition-all transform hover:scale-105 flex items-center gap-3 whitespace-nowrap"
                >
                    <svg class="w-6 md:w-5 h-6 md:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    Cómo llegar
                </a>
            </div>
        </section>

        <FaqSection />

        <CtaServicios phone="34626734479" mensaje="¡Hola! Me interesa información sobre los servicios personalizados de Taronja Box Moncada (sesiones 1x1, psicología deportiva, osteopatía, pádel, fisioterapia)." />
    </div>
    <WhatsAppButton phone="34626734479" message="¡Hola! Estoy interesado en Taronja Box Moncada." />
</Layout>
