          <!-- Lightbox / Modal -->
          <div id="lightbox" class="fixed inset-0 z-[100] bg-primary/95 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center p-4 md:p-12">
            <button id="lightbox-close" class="absolute top-6 right-6 text-white/50 hover:text-white transition-colors">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
            <img id="lightbox-img" src="" alt="Full size" class="max-w-full max-h-full object-contain rounded-sm shadow-2xl scale-95 transition-transform duration-300" />
          </div>

          <script>
            // --- Toggle Gallery Logic ---
            const btn = document.getElementById('load-more-btn');
            const btnText = document.getElementById('btn-text');
            const btnIcon = document.getElementById('btn-icon');
            const extraItems = document.querySelectorAll('.extra-item');
            let isOpen = false;

            btn?.addEventListener('click', () => {
              isOpen = !isOpen;
              extraItems.forEach((item, index) => {
                if (isOpen) {
                  item.classList.remove('hidden');
                  setTimeout(() => item.classList.remove('opacity-0', 'translate-y-4'), index * 100);
                } else {
                  item.classList.add('opacity-0', 'translate-y-4');
                  setTimeout(() => item.classList.add('hidden'), 500);
                }
              });
              if (btnText) btnText.textContent = isOpen ? 'Ver menos imágenes' : 'Ver más imágenes';
              if (btnIcon) isOpen ? btnIcon.classList.add('rotate-180') : btnIcon.classList.remove('rotate-180');
            });

            // --- Lightbox Logic ---
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
            const lightboxClose = document.getElementById('lightbox-close');
            const galleryImages = document.querySelectorAll('.gallery-img, .md\\:col-span-4 img, .md\\:col-span-2 img');

            galleryImages.forEach(img => {
              img.parentElement?.classList.add('cursor-pointer');
              img.addEventListener('click', () => {
                const src = (img as HTMLImageElement).src;
                if (lightbox && lightboxImg) {
                  lightboxImg.src = src;
                  lightbox.classList.remove('opacity-0', 'pointer-events-none');
                  setTimeout(() => lightboxImg.classList.remove('scale-95'), 10);
                }
              });
            });

            const closeLightbox = () => {
              if (lightbox && lightboxImg) {
                lightbox.classList.add('opacity-0', 'pointer-events-none');
                lightboxImg.classList.add('scale-95');
              }
            };

            lightboxClose?.addEventListener('click', closeLightbox);
            lightbox?.addEventListener('click', (e) => {
              if (e.target === lightbox) closeLightbox();
            });
          </script>
